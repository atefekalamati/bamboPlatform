DATABASE_URL=postgresql+psycopg://bambo:bambo@localhost:5432/bambo
APP_ENV=development
AUTH_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_SUPER_ADMIN_MOBILE=+989150000000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_MAX_IP_REQUESTS_PER_WINDOW=20
OTP_RATE_WINDOW_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_SESSION_TTL_SECONDS=28800
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
DWG_STORAGE_BACKEND=local
DWG_STORAGE_ROOT=./storage/dwg
DWG_MAX_BYTES=52428800
