APP_ENV=production
DATABASE_URL=postgresql+psycopg://runtime_user@db:5432/bambo?sslmode=require
AUTH_SECRET=REPLACE_FROM_SECRET_MANAGER_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CORS_ORIGINS=https://pilot.example.invalid
TRUSTED_HOSTS=api.example.invalid
ENABLE_API_DOCS=false
DEBUG=false
AUTH_SESSION_TTL_SECONDS=28800
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_MAX_IP_REQUESTS_PER_WINDOW=20
OTP_RATE_WINDOW_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=60
SMS_PROVIDER=http_json
SMS_ENABLED=false
SMS_API_URL=https://sms-provider.example.invalid/v1/messages
SMS_API_KEY=REPLACE_FROM_SECRET_MANAGER
SMS_SENDER=BAMBO
SMS_TIMEOUT_SECONDS=10
PLATFORM_LOGIN_URL=https://pilot.example.invalid
CALL_PROVIDER=astel
ASTEL_BASE_URL=
ASTEL_API_KEY=
ASTEL_API_SECRET=
ASTEL_WEBHOOK_SECRET=
ASTEL_CALLBACK_URL=
ASTEL_REQUEST_TIMEOUT_SECONDS=15
ASTEL_RECORDING_ENABLED=false
DWG_STORAGE_BACKEND=local
DWG_STORAGE_ROOT=/data/dwg
DWG_MAX_BYTES=52428800
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSLMODE=require
WEB_CONCURRENCY=1
FORWARDED_ALLOW_IPS=REVERSE_PROXY_IP_OR_CIDR
LOG_LEVEL=INFO
RELEASE_VERSION=REPLACE_WITH_IMMUTABLE_RELEASE
ALLOW_SUPER_ADMIN_BOOTSTRAP=false
# BOOTSTRAP_SUPER_ADMIN_MOBILE is intentionally absent after controlled bootstrap.
# SENTRY_DSN is optional and must only be set after organizational approval.
